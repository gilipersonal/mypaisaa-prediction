    {
      "id": "prediction-lifecycle",
      "title": "Prediction-to-outcome lifecycle",
      "width": 1400,
      "height": 850,
      "subtitle": "PLANNED SCIENTIFIC CONTROLS: retain what was known, what was predicted, and what later happened.",
      "description": "A fixed data cutoff precedes purged walk-forward evaluation, with transforms and calibration fit inside each training fold. Approved model runs publish immutable predictions. Outcomes are collected only after maturity, then scored against declared benchmarks.",
      "note": "Never random-split time series. No future leakage. Corrections append a superseding version.",
      "footer": "Every forecast records target, horizon, cutoff, model version, uncertainty/calibration and cited explanation.",
      "bands": [
        {
          "x": 40,
          "y": 135,
          "text": "01 / TIME-AWARE EVALUATION"
        },
        {
          "x": 40,
          "y": 435,
