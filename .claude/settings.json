{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout main)",
      "Bash(git checkout -q main)",
      "Bash(git checkout MP-*)",
      "Bash(git checkout -q MP-*)",
      "Bash(git checkout -b MP-*)",
      "Bash(git checkout -q -b MP-*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git pull --ff-only)",
      "Bash(git pull -q --ff-only)",
      "Bash(git push -u origin MP-*)",
      "Bash(git push origin MP-*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__addOrEditJiraIssueComment",
      "mcp__atlassian__executeRead"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge:*)",
      "Bash(git merge:*)",
      "Bash(gh api *pulls/*/merge*)",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__atlassian__transitionJiraIssue"
    ],
    "deny": [
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/mp_hook.py\" before-pr",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/mp_hook.py\" after-edit",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/mp_hook.py\" new-work",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
