{
  "extends": "$app/tsconfig",
  "include": [
    "src",
    "tests",
    "*"
  ],
  "exclude": [
    "src/service-worker"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  }
}
